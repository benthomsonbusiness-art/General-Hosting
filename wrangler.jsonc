{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default deploy target for the rebuild. The existing preview Worker is valentini-preview;
  // do not overwrite it without approval.
  "name": "valentini-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "valentini-next" }],
  "observability": { "enabled": true }
  // Add "account_id" from `wrangler whoami` if the login has more than one account.
  // Optional inquiry storage. Create the database first (see HANDOFF.md), then uncomment:
  // "d1_databases": [
  //   { "binding": "INQUIRIES_DB", "database_name": "valentini-inquiries", "database_id": "<id>", "migrations_dir": "migrations" }
  // ]
}